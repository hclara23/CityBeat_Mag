{
  "name": "citybeat-mag",
  "version": "1.0.0",
  "description": "CityBeat - Bilingual local magazine (EN/ES)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "node scripts/run-tests.mjs",
    "test:list": "node scripts/run-tests.mjs --list",
    "scheduler:check": "node scripts/check-scheduler.mjs",
    "scheduler:capture": "node scripts/check-scheduler.mjs --capture"
  },
  "devDependencies": {
    "cypress": "^15.17.0",
    "tsx": "^4.22.4",
    "turbo": "^1.10.16"
  },
  "packageManager": "npm@9.0.0"
}
